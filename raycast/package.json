{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "foltty",
  "title": "Foltty",
  "description": "Universal project and folder launcher for macOS terminal emulators",
  "icon": "icon.png",
  "author": "Developer",
  "categories": [
    "Developer Tools"
  ],
  "license": "MIT",
  "commands": [
    {
      "name": "index",
      "title": "Search Projects",
      "icon": "icon.png",
      "description": "Browse registered projects and launch them in your preferred terminal",
      "mode": "view"
    }
  ],
  "preferences": [
    {
      "name": "defaultTerminal",
      "type": "dropdown",
      "title": "Default Terminal Emulator",
      "description": "Choose which terminal emulator to open projects with",
      "default": "auto",
      "required": false,
      "data": [
        {
          "title": "Auto Detect (Ghostty > iTerm2 > WezTerm > Warp > Terminal)",
          "value": "auto"
        },
        {
          "title": "Ghostty",
          "value": "ghostty"
        },
        {
          "title": "iTerm2",
          "value": "iterm"
        },
        {
          "title": "WezTerm",
          "value": "wezterm"
        },
        {
          "title": "Alacritty",
          "value": "alacritty"
        },
        {
          "title": "Kitty",
          "value": "kitty"
        },
        {
          "title": "Warp",
          "value": "warp"
        },
        {
          "title": "Apple Terminal",
          "value": "terminal"
        }
      ]
    },
    {
      "name": "ghosttyTarget",
      "type": "dropdown",
      "title": "Ghostty Open Mode",
      "description": "Choose whether Ghostty opens projects in a new window or a new tab",
      "default": "window",
      "required": false,
      "data": [
        {
          "title": "New Window (default)",
          "value": "window"
        },
        {
          "title": "New Tab",
          "value": "tab"
        }
      ]
    }
  ],
  "dependencies": {
    "@raycast/api": "^2.8.2",
    "@raycast/utils": "^2.3.3"
  },
  "devDependencies": {
    "@raycast/eslint-config": "2.2.0",
    "@types/node": "^22.13.0",
    "@types/react": "^19.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.4.2",
    "react": "^19.0.0",
    "typescript": "^5.7.3"
  },
  "scripts": {
    "build": "ray build -e dist",
    "dev": "ray develop",
    "lint": "ray lint",
    "fix-lint": "ray lint --fix"
  }
}
